+        def syncMissingDesktopFiles(apps, generation):
+            if generation != desktop_generation or stopping:
+                return
+            for app in apps:
+                desktop_file = apps_dir / f"waydroid.{app['packageName']}.desktop"
+                if not desktop_file.exists():
+                    updateDesktopFile(app)
+
+        def queryFinished():
+            nonlocal pending
+            pending = 0
+
+        def poll():
+            nonlocal pending
+            if not pending:
+                generation = desktop_generation
+                pending = platformService.getAppsInfoAsync(
+                    lambda apps: syncMissingDesktopFiles(apps, generation), queryFinished
+                )
+            return GLib.SOURCE_CONTINUE
+
+        source = GLib.timeout_add_seconds(30, poll)
+
+        def stopSync():
+            nonlocal desktop_generation
+            desktop_generation += 1
+            GLib.source_remove(source)
+            if pending:
+                platformService.client.cancel(pending)
+
+        return stopSync
